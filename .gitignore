# Secrets — never commit
.env

# All files the scripts pull down or extract (key cache, ISOs, unpacked trees)
build/

# Stray QEMU source extraction (the real patched build tree is build/qemu-src/)
/qemu-11.1.0/

# Large firmware artifacts (wherever they land)
*.iso
*.UPD

# Python
__pycache__/
*.pyc
venv/
.venv/

# macOS
.DS_Store

# USB test images (large; place your own rekordbox-formatted image here)
test/usb/*.img
test/usb/*.dmg
tools/xdj-panel/assets/calibration.json
