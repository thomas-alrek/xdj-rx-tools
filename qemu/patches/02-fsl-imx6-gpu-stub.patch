+/*
+ * XDJ-RX: CCM CACRR (ARM clock-root divider) write trap for the bus-freq DVFS.
+ *
+ * Enabling the GPU makes the firmware raise the bus frequency, and the i.MX6
+ * bus-frequency DVFS does an ARM-clock / DDR frequency change (writing CACRR,
+ * CCM 0x020c4000 + 0x10) with CPU interrupts masked, then waits for the next
+ * timer tick as a settling delay (single-core busy-polls GICC_HPPIR; SMP does
+ * WFI).  The kernel runs the GPT one-shot and does not reprogram it inside that
+ * masked window, so under emulation no tick arrives and the DVFS hangs.  We trap
+ * the CACRR write and hand the kernel a GPT tick (imx_gpt_kick) so the settling
+ * completes.  CACRR resets to 0 and QEMU's CCM clock model does not use it, so a
+ * self-contained shadow is identical to the CCM's own behaviour.  Installed only
+ * on the XDJ_GPU2D full-stock-boot path, so the default path is unaffected.
+ */
+static uint32_t xdj_cacrr_shadow;
+static IMXGPTState *xdj_dvfs_gpt;
+
+static uint64_t xdj_cacrr_read(void *opaque, hwaddr off, unsigned size)
+{
+    return xdj_cacrr_shadow;
+}
+
+static void xdj_cacrr_write(void *opaque, hwaddr off, uint64_t val,
+                            unsigned size)
+{
+    xdj_cacrr_shadow = (uint32_t)val;
+    if (xdj_dvfs_gpt) {
+        imx_gpt_kick(xdj_dvfs_gpt);
+    }
+}
+
+static const MemoryRegionOps xdj_cacrr_ops = {
+    .read = xdj_cacrr_read,
+    .write = xdj_cacrr_write,
+    .endianness = DEVICE_NATIVE_ENDIAN,
+    .valid = { .min_access_size = 4, .max_access_size = 4 },
+};
