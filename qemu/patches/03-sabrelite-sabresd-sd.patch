         }
     }
 
+    /*
+     * XDJ-RX front-panel microcontroller ("Subucom"): an SSI slave on ECSPI2
+     * (the SoC's "spi2"), where the SABRE-SD board init puts the subucom_spi1.0
+     * device. Attached after the SoC is realized (like the NOR flash above).
+     */
+    {
+        Object *spi2 = object_resolve_path_component(OBJECT(&s->soc), "spi2");
+
+        if (spi2) {
+            SSIBus *bus = (SSIBus *)qdev_get_child_bus(DEVICE(spi2), "spi");
+
+            if (bus) {
+                qdev_realize_and_unref(qdev_new("xdj-subucom"), BUS(bus),
+                                       &error_fatal);
+            }
+        }
+    }
+
+    /*
+     * Attach the SD card named "xdjsd" (from -drive if=none,id=xdjsd,...) to
+     * uSDHC3. The XDJ-RX firmware uses the SABRE-SD board init, whose rootfs
+     * eMMC/SD is on uSDHC3 (Linux mmc0 = sdhci-esdhc-imx.2). An if=none drive
+     * is exempt from the orphan check, so no auto-create machinery is needed.
+     * This matches the real board; the firmware is unmodified.
+     */
+    {
+        BlockBackend *blk = blk_by_name("xdjsd");
+
+        if (blk) {
+            Object *usdhc = object_resolve_path_component(OBJECT(&s->soc),
+                                                          "sdhc3");
+            if (usdhc) {
+                BusState *sdbus = qdev_get_child_bus(DEVICE(usdhc), "sd-bus");
+                DeviceState *card = qdev_new(TYPE_SD_CARD);
+
+                qdev_prop_set_drive_err(card, "drive", blk, &error_fatal);
+                qdev_realize_and_unref(card, sdbus, &error_fatal);
+            }
+        }
+    }
+
     sabrelite_binfo.ram_size = machine->ram_size;
     sabrelite_binfo.secure_boot = true;
     sabrelite_binfo.write_secondary_boot = sabrelite_write_secondary;
