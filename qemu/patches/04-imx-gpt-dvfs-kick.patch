+/*
+ * XDJ-RX: deliver an immediate output-compare-1 interrupt (a timer "tick").
+ *
+ * The i.MX6 bus-frequency DVFS (triggered when the firmware enables the GPU)
+ * does an ARM-clock / DDR frequency change with CPU interrupts masked and then
+ * waits for the next timer tick as a settling delay -- single-core busy-polls
+ * the GIC (GICC_HPPIR), SMP does WFI on every core.  The kernel runs the GPT as
+ * a one-shot clockevent and does not reprogram its compare inside that masked
+ * window, so under emulation no further tick is scheduled and the DVFS hangs
+ * forever.  The machine calls this on the CCM clock-step register write to hand
+ * the kernel the tick it is waiting for, so the DVFS completes and the fully
+ * stock firmware boots.  (This is exactly how the GPT raises its own OF1
+ * interrupt; the kernel's handler clears SR, which drops the line.)
+ */
+void imx_gpt_kick(IMXGPTState *s)
+{
+    s->sr |= GPT_SR_OF1;
+    imx_gpt_update_int(s);
 }
 
 static uint32_t imx_gpt_update_count(IMXGPTState *s)
