@@ -171,6 +171,18 @@
     } else {
         qemu_irq_lower(s->irq);
     }
+}
+
+/*
+ * XDJ-RX: deliver an immediate output-compare-1 interrupt (a timer "tick") to
+ * unblock the i.MX6 bus-frequency DVFS settling wait.  Sets OF1 and raises the
+ * line exactly as the GPT does for a real compare; the kernel's handler clears
+ * SR, dropping the line.  See hw/arm/fsl-imx6.c (xdj_dvfs_gpt_kick).
+ */
+void imx_gpt_kick(IMXGPTState *s)
+{
+    s->sr |= GPT_SR_OF1;
+    imx_gpt_update_int(s);
 }
 
