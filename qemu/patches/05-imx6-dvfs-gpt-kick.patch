@@ -513,6 +520,23 @@
      * cannot be written to.
      */
     s->ccm[index] = (uint32_t)value;
+
+    /*
+     * The bus-frequency DVFS steps the ARM/AHB/DDR clocks by writing these
+     * registers with CPU interrupts masked, then busy-polls GICC_HPPIR for the
+     * next timer tick as a settling delay.  That poll deadlocks under emulation
+     * (the one-shot GPT is not reprogrammed in the masked window), so deliver
+     * the awaited tick on each clock-step write that precedes a settling wait.
+     */
+    switch (index) {
+    case CCM_CCSR:      /* clock switcher (step/pll2 bypass)       */
+    case CCM_CACRR:     /* ARM clock root divider                  */
+    case CCM_CGPR:      /* INT_MEM_CLK_LPM DDR handshake enable     */
+        xdj_dvfs_gpt_kick();
+        break;
+    default:
+        break;
+    }
 }
 
