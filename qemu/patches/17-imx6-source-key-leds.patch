XDJ-RX patch 17: source-key LEDs (rekordbox / MIDI / USB1 / USB2).

These four LEDs are not in SubTxData: rbp drives them as GPIO OUTPUTS 162..165
(GPIO6_IO02..05; PanelComController), active-high and one-hot -- rekordbox=162,
MIDI=163, USB1=164, USB2=165 (verified live 2026-11-15 by reading GPIO6 DR while
pressing each key). Connect those four output lines, mirror them into a bitmask
(bit0 rekordbox .. bit3 USB2) and append it to every published LED line as a 21st
byte ("T <40 hex> <2 hex>"), re-publishing on each pin change. The web panel reads
it as LED byte 0x14.

--- a/hw/arm/fsl-imx6.c
+++ b/hw/arm/fsl-imx6.c
@@ -1615,10 +1615,16 @@
  */
 #define XDJ_TX_PAYLOAD 20
 #define XDJ_TX_CRC_OFF 0x16
+
+/* Source-key LEDs (rekordbox / MIDI / USB1 / USB2). Not in SubTxData: rbp drives
+ * them as GPIO outputs 162..165 (GPIO6_IO02..05, active-high, one-hot, verified
+ * live 2026-11-15). Mirrored here (bit0 = rekordbox .. bit3 = USB2) and appended
+ * to every published LED line as a 21st byte. */
+static uint8_t g_xdj_srcled;
 
 static void xdj_subucom_tx_publish(const uint8_t *tx)
 {
-    char line[8 + 2 * XDJ_TX_PAYLOAD];
+    char line[12 + 2 * XDJ_TX_PAYLOAD];
     int i, n;
     XdjCtrlChan *c = &xdj_ctrl_chan;
 
@@ -1626,6 +1632,7 @@
     for (i = 0; i < XDJ_TX_PAYLOAD; i++) {
         n += snprintf(line + n, sizeof(line) - n, "%02x", tx[i]);
     }
+    n += snprintf(line + n, sizeof(line) - n, " %02x", g_xdj_srcled);
     line[n++] = '\n';
     if (xdj_ctrl_bind(c)) {
         xdj_ctrl_chan_write(c, (const uint8_t *)line, n);
@@ -1693,6 +1700,20 @@
     memcpy(s->tx_pub, tx, XDJ_TX_PAYLOAD);
     s->tx_pub_valid = true;
     xdj_subucom_tx_publish(tx);
+}
+
+/* GPIO6_IO02..05 output edge (rbp switched source): mirror and re-publish. */
+static void xdj_srcled_set(void *opaque, int n, int level)
+{
+    uint8_t v = level ? (g_xdj_srcled | (1u << n)) : (g_xdj_srcled & ~(1u << n));
+
+    if (v == g_xdj_srcled) {
+        return;
+    }
+    g_xdj_srcled = v;
+    if (g_xdj_subucom && g_xdj_subucom->tx_pub_valid) {
+        xdj_subucom_tx_publish(g_xdj_subucom->tx_pub);
+    }
 }
 
 /*
@@ -2444,6 +2465,13 @@
         if (i < 8) {         /* capture every bank for the MAIN-UCOM key hook */
             g_xdj_gpio[i] = DEVICE(&s->gpio[i]);
         }
+        if (i == 5) {        /* GPIO6_IO02..05 = source-key LEDs (rbp outputs) */
+            int pin;
+            for (pin = 2; pin <= 5; pin++) {
+                qdev_connect_gpio_out(DEVICE(&s->gpio[i]), pin,
+                                      qemu_allocate_irq(xdj_srcled_set, NULL, pin - 2));
+            }
+        }
 
         sysbus_mmio_map(SYS_BUS_DEVICE(&s->gpio[i]), 0, gpio_table[i].addr);
         sysbus_connect_irq(SYS_BUS_DEVICE(&s->gpio[i]), 0,
